<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Compact brand bar: no oversized marketing hero above a 100+ video library. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="67dp"
        android:gravity="center_vertical" android:orientation="horizontal"
        android:paddingStart="18dp" android:paddingEnd="17dp">
        <ImageView android:layout_width="42dp" android:layout_height="42dp"
            android:src="@drawable/orbit_launcher" android:contentDescription="Orbit Player Pro" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="10dp"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Orbit" android:textSize="22sp" android:textStyle="bold"
                    android:textColor="#F7F8FF" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="7dp" android:gravity="center"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="3dp" android:paddingBottom="3dp"
                    android:text="PRO" android:letterSpacing="0.13"
                    android:textSize="10sp" android:textStyle="bold"
                    android:textColor="#66DEED" android:background="@drawable/orbit_pro_badge_bg"/>
            </LinearLayout>
            <TextView android:id="@+id/subtitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="1dp"
                android:text="YOUR OFFLINE CINEMA" android:letterSpacing="0.13"
                android:textColor="#8E9DBA" android:textSize="9sp" />
        </LinearLayout>
        <ImageView android:id="@+id/btnPick" android:layout_width="43dp"
            android:layout_height="43dp" android:padding="11dp" android:layout_marginEnd="8dp"
            android:src="@drawable/orbit_nav_open"
            android:background="@drawable/orbit_icon_surface"
            android:contentDescription="Open a video from device" />
        <ImageView android:id="@+id/btnPlaylists" android:layout_width="42dp"
            android:layout_height="43dp" android:padding="11dp" android:layout_marginEnd="8dp"
            android:src="@drawable/orbit_nav_list"
            android:background="@drawable/orbit_icon_surface"
            android:contentDescription="My playlists" />
        <ImageView android:id="@+id/btnSettings" android:layout_width="43dp"
            android:layout_height="43dp" android:padding="11dp" android:layout_marginEnd="8dp"
            android:src="@drawable/orbit_ic_settings"
            android:background="@drawable/orbit_icon_surface"
            android:contentDescription="Settings" />
        <ImageView android:id="@+id/btnRefresh" android:layout_width="46dp"
            android:layout_height="46dp" android:padding="12dp"
            android:src="@drawable/orbit_nav_refresh"
            android:background="@drawable/orbit_icon_surface"
            android:contentDescription="Refresh local videos" />
    </LinearLayout>

    <!-- Display only when a real previously watched item exists. -->
    <LinearLayout android:id="@+id/continueCard"
        android:layout_width="match_parent" android:layout_height="85dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginStart="17dp" android:layout_marginEnd="17dp"
        android:layout_marginTop="6dp" android:layout_marginBottom="9dp"
        android:paddingStart="8dp" android:paddingEnd="14dp"
        android:background="@drawable/orbit_continue_bg"
        android:visibility="gone">
        <ImageView android:id="@+id/continueThumb" android:layout_width="105dp"
            android:layout_height="69dp" android:background="@drawable/orbit_thumb_bg"
            android:scaleType="centerCrop" android:clipToOutline="true"
            android:contentDescription="Continue watching video thumbnail" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:paddingStart="12dp" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="CONTINUE WATCHING" android:textColor="#58D6E8"
                android:textSize="9sp" android:letterSpacing="0.12"/>
            <TextView android:id="@+id/continueTitle" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:text="Continue" android:layout_marginTop="5dp"
                android:textColor="#F6F7FC" android:textStyle="bold" android:textSize="13sp"/>
            <TextView android:id="@+id/continueDetails" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1"
                android:textColor="#9AAAC7" android:textSize="11sp" android:layout_marginTop="4dp"/>
        </LinearLayout>
        <ImageView android:layout_width="35dp" android:layout_height="35dp"
            android:padding="8dp" android:src="@drawable/orbit_ic_play"
            android:background="@drawable/orbit_continue_play_bg"
            android:contentDescription="Resume video" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
        android:layout_marginStart="17dp" android:layout_marginEnd="17dp"
        android:layout_marginTop="6dp" android:gravity="center_vertical"
        android:orientation="horizontal" android:background="@drawable/orbit_search_bg">
        <ImageView android:layout_width="44dp" android:layout_height="match_parent"
            android:padding="13dp" android:src="@drawable/orbit_nav_search"
            android:contentDescription="Search" />
        <EditText android:id="@+id/search" android:layout_width="0dp"
            android:layout_height="match_parent" android:layout_weight="1"
            android:background="@android:color/transparent" android:singleLine="true"
            android:hint="Search videos or folders" android:inputType="text"
            android:textSize="14sp" android:textColor="#F8F8FF"
            android:textColorHint="#8292B1" android:paddingEnd="7dp"
            android:imeOptions="actionSearch"/>
        <TextView android:id="@+id/clearSearch" android:layout_width="42dp"
            android:layout_height="match_parent" android:gravity="center"
            android:text="×" android:textSize="24sp" android:textColor="#9DACCB"
            android:contentDescription="Clear search" android:visibility="gone" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="51dp"
        android:layout_marginStart="18dp" android:layout_marginEnd="17dp"
        android:layout_marginTop="7dp" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/sectionTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Your Library"
                android:textSize="20sp" android:fontFamily="sans-serif-medium"
                android:textColor="#F5F7FF"/>
        </LinearLayout>
        <TextView android:id="@+id/btnSort" android:layout_width="wrap_content"
            android:layout_height="38dp" android:minWidth="90dp" android:gravity="center"
            android:paddingHorizontal="11dp" android:text="Newest  ▾"
            android:textColor="#C6D0ED" android:textSize="12sp"
            android:background="@drawable/orbit_chip_bg" />
        <ImageView android:id="@+id/btnView" android:layout_width="40dp"
            android:layout_height="38dp" android:padding="10dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/orbit_nav_list"
            android:background="@drawable/orbit_chip_bg"
            android:contentDescription="Switch to compact list" />
    </LinearLayout>

    <HorizontalScrollView android:id="@+id/filterScroller" android:layout_width="match_parent"
        android:layout_height="44dp" android:fillViewport="false"
        android:scrollbars="none" android:paddingStart="17dp">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingEnd="17dp">
            <TextView android:id="@+id/filterAll" style="@style/OrbitLibraryChip"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="All videos"/>
            <TextView android:id="@+id/filterFavorites" style="@style/OrbitLibraryChip"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="★ Favorites" />
            <TextView android:id="@+id/formatFilter" style="@style/OrbitLibraryChip"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Format  ▾" android:contentDescription="Filter videos by file type"/>
            <TextView android:id="@+id/filterProgress" style="@style/OrbitLibraryChip"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Continue" />
            <TextView android:id="@+id/filterHistory" style="@style/OrbitLibraryChip"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="History" android:visibility="gone" />
            <TextView android:id="@+id/filterRecent" style="@style/OrbitLibraryChip"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="Recent" />
            <TextView android:id="@+id/folderFilter" style="@style/OrbitLibraryChip"
                android:layout_width="wrap_content" android:layout_height="36dp"
                android:text="All folders  ▾" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="29dp"
        android:paddingStart="19dp" android:paddingEnd="18dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/count" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:text="Your videos" android:textSize="11sp" android:textColor="#8293B4"/>
        <TextView android:id="@+id/btnGrant" android:layout_width="wrap_content"
            android:layout_height="match_parent" android:gravity="center"
            android:text="Access" android:textSize="11sp" android:textColor="#68D6E6"
            android:contentDescription="Manage local video access" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/videos"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:paddingStart="12dp" android:paddingEnd="12dp"
            android:paddingTop="4dp" android:paddingBottom="12dp"
            android:clipToPadding="false" android:scrollbars="none"/>
        <TextView android:id="@+id/empty" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:gravity="center" android:padding="25dp"
            android:text="No videos found\nTry another filter or open a video."
            android:textSize="14sp" android:textColor="#A8B6D3"
            android:lineSpacingExtra="7dp"/>
    </FrameLayout>

    <!-- Every navigation item performs a real action; no decorative dead-end tabs. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="63dp"
        android:layout_marginStart="17dp" android:layout_marginEnd="17dp"
        android:layout_marginBottom="10dp" android:paddingHorizontal="8dp"
        android:gravity="center" android:orientation="horizontal"
        android:background="@drawable/orbit_bottom_nav_bg">
        <LinearLayout android:id="@+id/navHome" style="@style/OrbitBottomNavItem"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/orbit_nav_library"
                android:contentDescription="Library" android:tint="#9C84FA"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Library" android:textSize="10sp"
                android:textColor="#AE98FF"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navFolders" style="@style/OrbitBottomNavItem"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/orbit_nav_folder" android:tint="#9AA9C4"
                android:contentDescription="Folders"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Folders" android:textSize="10sp"
                android:textColor="#9AA9C4"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navContinue" style="@style/OrbitBottomNavItem"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/orbit_nav_resume" android:tint="#9AA9C4"
                android:contentDescription="Continue watching"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Continue" android:textSize="10sp"
                android:textColor="#9AA9C4"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/navSearch" style="@style/OrbitBottomNavItem"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/orbit_nav_search" android:tint="#9AA9C4"
                android:contentDescription="Search videos"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Search" android:textSize="10sp"
                android:textColor="#9AA9C4"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>