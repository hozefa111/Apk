<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="72dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/orbit_touch_feedback" android:paddingStart="8dp">
    <TextView android:id="@+id/queueNumber" android:layout_width="36dp" android:layout_height="wrap_content"
        android:gravity="center" android:textSize="13sp" android:textColor="@color/text_secondary"
        android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="8dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <TextView android:id="@+id/queueTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="2" android:ellipsize="end" android:textSize="14sp" android:textColor="@color/text_main"
            android:fontFamily="sans-serif-medium" android:importantForAccessibility="no"/>
        <TextView android:id="@+id/queueDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:maxLines="1" android:ellipsize="end" android:layout_marginTop="4dp"
            android:textSize="12sp" android:textColor="@color/text_secondary" android:importantForAccessibility="no"/>
    </LinearLayout>
    <ImageView android:id="@+id/queueMore" android:layout_width="48dp" android:layout_height="48dp"
        android:padding="13dp" android:src="@drawable/orbit_ic_more" android:background="@drawable/orbit_touch_feedback"/>
</LinearLayout>
