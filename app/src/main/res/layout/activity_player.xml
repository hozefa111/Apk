<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ExoPlayer still owns decoding, buffering and subtitles; Orbit renders the controls. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:use_controller="false"
        app:show_buffering="always"
        app:resize_mode="fit"
        app:keep_content_on_player_reset="true" />

    <FrameLayout
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cinematic top fade; disappears entirely during video playback. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/player_toolbar_bg"
        android:paddingStart="12dp"
        android:paddingEnd="10dp">
        <TextView
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:contentDescription="Back to library"
            android:text="‹"
            android:textSize="36sp"
            android:textColor="#FFFFFF"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Now playing"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ORBIT CINEMA"
                android:letterSpacing="0.18"
                android:textColor="#A9E9F2"
                android:textSize="10sp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/btnPip"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:contentDescription="Picture in picture"
            android:text="▣"
            android:textColor="#F5F4FF"
            android:textSize="22sp"/>
        <TextView
            android:id="@+id/btnTracks"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:contentDescription="Audio and subtitle tracks"
            android:text="A/V"
            android:textColor="#F5F4FF"
            android:textSize="12sp"/>
        <TextView
            android:id="@+id/btnInfo"
            android:layout_width="40dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:contentDescription="Video information"
            android:text="ⓘ"
            android:textColor="#F5F4FF"
            android:textSize="21sp"/>
        <TextView
            android:id="@+id/btnMore"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:contentDescription="More playback options"
            android:text="⋮"
            android:textColor="#FFFFFF"
            android:textSize="26sp"/>
    </LinearLayout>

    <!-- Large, comfortably spaced central transport. -->
    <LinearLayout
        android:id="@+id/centerControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/btnPrevious"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/orbit_transport_bg"
            android:gravity="center"
            android:src="@drawable/orbit_ic_previous"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:contentDescription="Previous video"
            />
        <TextView
            android:id="@+id/btnRewind"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/orbit_transport_bg"
            android:gravity="center"
            android:contentDescription="Rewind 10 seconds"
            android:text="↶10"
            android:textColor="#FFFFFF"
            android:textSize="22sp"/>
        <ImageView
            android:id="@+id/btnPlayPause"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_marginHorizontal="4dp"
            android:gravity="center"
            android:src="@drawable/orbit_ic_play"
            android:padding="17dp"
            android:scaleType="centerInside"
            android:contentDescription="Play or pause"
            android:background="@drawable/orbit_player_play_bg"
            android:elevation="7dp"/>
        <TextView
            android:id="@+id/btnForward"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/orbit_transport_bg"
            android:gravity="center"
            android:contentDescription="Forward 10 seconds"
            android:text="10↷"
            android:textColor="#FFFFFF"
            android:textSize="22sp"/>
        <ImageView
            android:id="@+id/btnNext"
            android:layout_width="48dp"
            android:layout_height="52dp"
            android:layout_marginHorizontal="3dp"
            android:background="@drawable/orbit_transport_bg"
            android:gravity="center"
            android:src="@drawable/orbit_ic_next"
            android:padding="14dp"
            android:scaleType="centerInside"
            android:contentDescription="Next video"
            />
    </LinearLayout>

    <!-- Playback timeline, quick subtitle/audio options and screen lock. -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="18dp"
        android:background="@drawable/player_bottom_bg">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/timeCurrent"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>
            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:contentDescription="Video position"
                android:progressTint="#A77BFF"
                android:progressBackgroundTint="#558495B0"
                android:secondaryProgressTint="#6081DCFF"
                android:thumb="@drawable/orbit_seek_thumb"
                android:splitTrack="false"/>
            <TextView
                android:id="@+id/timeDuration"
                android:contentDescription="Toggle total or remaining duration"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00"
                android:textColor="#E8E9F9"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/btnLock"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:gravity="center"
                android:contentDescription="Lock screen controls"
                android:text="♙  Lock"
                android:textColor="#D9E0F6"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/btnSubs"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:gravity="center"
                android:contentDescription="Choose subtitles"
                android:text="CC  Subs"
                android:textColor="#D9E0F6"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:gravity="center"
                android:contentDescription="Playback speed"
                android:text="1×  Speed"
                android:textColor="#D9E0F6"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/btnAspect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:gravity="center"
                android:contentDescription="Change video aspect ratio"
                android:text="▣  Fit"
                android:textColor="#D9E0F6"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/btnRotate"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:gravity="center"
                android:contentDescription="Rotate screen"
                android:text="⟳  Rotate"
                android:textColor="#D9E0F6"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/btnUnlock"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:gravity="center"
        android:background="@drawable/orbit_player_chip_bg"
        android:text="🔒  Unlock"
        android:textColor="#FFFFFF"
        android:visibility="gone"
        android:textSize="14sp"/>

    <LinearLayout
        android:id="@+id/gestureHud"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="82dp"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="13dp"
        android:background="@drawable/orbit_player_chip_bg"
        android:visibility="gone">
        <TextView
            android:id="@+id/gestureNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Seek"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"/>
        <ProgressBar
            android:id="@+id/gestureMeter"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="9dp"
            android:max="100"
            android:progress="0"
            android:progressTint="#61DDEB"
            android:progressBackgroundTint="#44627A9C" />
    </LinearLayout>
</FrameLayout>
