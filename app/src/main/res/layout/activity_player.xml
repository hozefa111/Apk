<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">
    <androidx.media3.ui.PlayerView android:id="@+id/playerView"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000"
        app:use_controller="true" app:show_buffering="when_playing"
        app:controller_show_timeout="4000" app:resize_mode="fit" />
    <LinearLayout android:id="@+id/topBar" android:visibility="gone" android:layout_width="match_parent"
        android:layout_height="62dp" android:gravity="center_vertical" android:background="@drawable/player_toolbar_bg" android:orientation="horizontal">
        <TextView android:id="@+id/back" android:layout_width="48dp" android:layout_height="match_parent"
            android:gravity="center" android:text="‹" android:textSize="34sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/playerTitle" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end"
            android:textSize="14sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/btnTracks" android:layout_width="50dp" android:layout_height="match_parent"
            android:gravity="center" android:text="A/V" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/btnSubs" android:layout_width="50dp" android:layout_height="match_parent"
            android:gravity="center" android:text="CC+" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/btnSpeed" android:layout_width="50dp" android:layout_height="match_parent"
            android:gravity="center" android:text="1×" android:textColor="#FFFFFF" android:textSize="13sp" />
        <TextView android:id="@+id/btnMore" android:layout_width="44dp" android:layout_height="match_parent"
            android:gravity="center" android:text="⋮" android:textColor="#FFFFFF" android:textSize="26sp" />
    </LinearLayout>
    <LinearLayout android:id="@+id/bottomControls" android:visibility="gone"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="74dp"
        android:background="@drawable/player_bottom_bg" android:orientation="horizontal" android:paddingHorizontal="18dp">
        <TextView android:id="@+id/btnPrevious" android:layout_width="60dp" android:layout_height="47dp"
            android:gravity="center" android:text="|◀" android:textSize="19sp" android:textColor="#FFFFFF" />
        <TextView android:id="@+id/btnNext" android:layout_width="60dp" android:layout_height="47dp"
            android:gravity="center" android:text="▶|" android:textSize="19sp" android:textColor="#FFFFFF" />
    </LinearLayout>
    <TextView android:id="@+id/gestureNotice" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:background="#B4000000" android:padding="14dp"
        android:textColor="#FFFFFF" android:textSize="16sp" android:visibility="gone" />
</FrameLayout>
