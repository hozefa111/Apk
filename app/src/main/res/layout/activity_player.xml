<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Leave the film unobstructed. Only this surface and gesture layer occupy the centre. -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:use_controller="false"
        app:show_buffering="always"
        app:resize_mode="fit"
        app:keep_content_on_player_reset="true" />

    <FrameLayout
        android:id="@+id/gestureLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Only essential actions at the top. Auto-hides as a single surface. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="14dp"
        android:background="@drawable/player_toolbar_bg">
        <ImageView
            android:id="@+id/back"
            android:layout_width="46dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/orbit_ic_back"
            android:contentDescription="Back to videos" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="9dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/playerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Now Playing"
                android:textStyle="bold"
                android:textColor="#F7F8FF"
                android:textSize="15sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:letterSpacing="0.20"
                android:text="O R B I T   P R O"
                android:textColor="#76D7E9"
                android:textSize="9sp" />
        </LinearLayout>
        <ImageView
            android:id="@+id/btnPip"
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:padding="12dp"
            android:src="@drawable/orbit_ic_pip"
            android:contentDescription="Picture in picture" />
        <ImageView
            android:id="@+id/btnMore"
            android:layout_width="44dp"
            android:layout_height="46dp"
            android:padding="10dp"
            android:src="@drawable/orbit_ic_more"
            android:contentDescription="Playback settings" />
    </LinearLayout>

    <!-- All transport and timeline controls belong to ONE bottom region. -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="13dp"
        android:background="@drawable/player_bottom_bg">

        <!-- Lightweight seek timeline with a separate buffered position. -->
        <LinearLayout
            android:id="@+id/timelineRow"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/timeCurrent"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:fontFamily="sans-serif-medium"
                android:gravity="start"
                android:textColor="#F8F8FF"
                android:textSize="12sp" />
            <SeekBar
                android:id="@+id/playerSeekBar"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:max="1000"
                android:progress="0"
                android:splitTrack="false"
                android:progressTint="#907CFA"
                android:secondaryProgressTint="#6476CAE6"
                android:progressBackgroundTint="#475F7490"
                android:thumb="@drawable/orbit_seek_thumb"
                android:contentDescription="Video seek bar" />
            <TextView
                android:id="@+id/timeDuration"
                android:layout_width="54dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="00:00"
                android:fontFamily="sans-serif-medium"
                android:textColor="#E7E9F6"
                android:textSize="12sp"
                android:contentDescription="Switch between total and remaining time" />
        </LinearLayout>

        <!-- Bottom-only transport. Never blocks the centre of the picture. -->
        <LinearLayout
            android:id="@+id/centerControls"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center">
            <ImageView
                android:id="@+id/btnPrevious"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="13dp"
                android:src="@drawable/orbit_ic_previous"
                android:contentDescription="Previous video"/>
            <TextView
                android:id="@+id/btnRewind"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="↶ 10"
                android:textColor="#DEE4F4"
                android:textSize="17sp"
                android:contentDescription="Rewind ten seconds"/>
            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="12dp"
                android:padding="17dp"
                android:src="@drawable/orbit_ic_play"
                android:background="@drawable/orbit_player_play_bg"
                android:contentDescription="Play or pause video"/>
            <TextView
                android:id="@+id/btnForward"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="10 ↷"
                android:textColor="#DEE4F4"
                android:textSize="17sp"
                android:contentDescription="Forward ten seconds"/>
            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="13dp"
                android:src="@drawable/orbit_ic_next"
                android:contentDescription="Next video"/>
        </LinearLayout>

        <!-- Quick actions. Automatically hidden in compact landscape. -->
        <LinearLayout
            android:id="@+id/quickActions"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <TextView
                android:id="@+id/btnLock"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="LOCK"
                android:textColor="#BECADD"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:contentDescription="Lock screen controls"/>
            <TextView
                android:id="@+id/btnSubs"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="SUBS"
                android:textColor="#BECADD"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:contentDescription="Choose external subtitles"/>
            <TextView
                android:id="@+id/btnTracks"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="AUDIO"
                android:textColor="#BECADD"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:contentDescription="Audio and subtitle tracks"/>
            <TextView
                android:id="@+id/btnSpeed"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="1×"
                android:textColor="#D7DDFF"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:contentDescription="Playback speed"/>
            <TextView
                android:id="@+id/btnAspect"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="FIT"
                android:textColor="#BECADD"
                android:textSize="11sp"
                android:letterSpacing="0.04"
                android:contentDescription="Video fit or crop"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Optional external SRT/VTT overlay: always outside the centre while controls are visible. -->
    <TextView android:id="@+id/externalSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="190dp"
        android:gravity="center"
        android:padding="5dp"
        android:visibility="gone"
        android:maxLines="4"
        android:textColor="#FFFFFF"
        android:shadowColor="#C0000000"
        android:shadowRadius="4"
        android:shadowDx="1"
        android:shadowDy="1"
        android:textSize="18sp"/>
        
    <!-- Small, non-obstructive feedback: only appears during an interaction. -->
    <LinearLayout
        android:id="@+id/gestureHud"
        android:layout_width="208dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:layout_marginTop="84dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="11dp"
        android:paddingBottom="12dp"
        android:orientation="vertical"
        android:background="@drawable/orbit_player_chip_bg"
        android:visibility="gone">
        <TextView
            android:id="@+id/gestureNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"
            android:textSize="13sp"/>
        <ProgressBar
            android:id="@+id/gestureMeter"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="9dp"
            android:max="100"
            android:progressTint="#5ACFE6"
            android:progressBackgroundTint="#485E718C" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnUnlock"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="top|start"
        android:layout_margin="15dp"
        android:gravity="center"
        android:paddingHorizontal="18dp"
        android:text="UNLOCK"
        android:textColor="#FFFFFF"
        android:fontFamily="sans-serif-medium"
        android:background="@drawable/orbit_player_chip_bg"
        android:visibility="gone"
        android:textSize="12sp"
        android:contentDescription="Unlock player controls"/>
</FrameLayout>
