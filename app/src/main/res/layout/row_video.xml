<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:layout_marginHorizontal="5dp" android:layout_marginBottom="12dp"
 android:orientation="vertical" android:padding="7dp"
 android:background="@drawable/orbit_gallery_card_bg">
 <FrameLayout android:layout_width="match_parent" android:layout_height="110dp"
   android:background="@drawable/orbit_thumb_bg" android:clipToOutline="true">
   <ImageView android:id="@+id/thumb" android:layout_width="match_parent"
    android:layout_height="match_parent" android:scaleType="centerCrop"
    android:contentDescription="Video preview"/>
   <ImageView android:id="@+id/moreOptions"
    android:layout_width="48dp" android:layout_height="48dp"
    android:layout_gravity="top|end" android:layout_margin="6dp"
    android:padding="8dp" android:background="@drawable/orbit_duration_bg"
    android:src="@drawable/orbit_ic_more"
    android:contentDescription="Video options"/>
   <TextView android:id="@+id/playGlyph" android:layout_width="38dp"
    android:layout_height="38dp" android:layout_gravity="center"
    android:gravity="center" android:text="▶" android:textColor="#FFFFFF"
    android:textSize="16sp" android:background="@drawable/play_badge_bg"/>
   <TextView android:id="@+id/duration" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:layout_gravity="bottom|end"
    android:layout_margin="7dp" android:paddingHorizontal="7dp"
    android:paddingVertical="3dp" android:background="@drawable/orbit_duration_bg"
    android:text="00:00" android:textSize="10sp" android:textColor="#FFFFFF"/>
 </FrameLayout>
 <TextView android:id="@+id/title" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:minHeight="42dp" android:layout_marginTop="8dp"
    android:paddingHorizontal="4dp" android:ellipsize="end" android:maxLines="2"
    android:textSize="14sp" android:fontFamily="sans-serif-medium"
    android:textColor="#F1F5FF"/>
 <TextView android:id="@+id/details" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginTop="2dp"
    android:paddingHorizontal="4dp" android:maxLines="1" android:ellipsize="end"
    android:textSize="11sp" android:textColor="#A7B4CE"/>
 <TextView android:id="@+id/favoriteBadge" android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:text="★ Favorite" android:visibility="gone"
    android:textColor="#C4A6FF" android:textSize="11sp" android:paddingStart="4dp"/>
 <ProgressBar android:id="@+id/watchProgress"
    style="?android:attr/progressBarStyleHorizontal"
    android:layout_width="match_parent" android:layout_height="3dp"
    android:layout_marginTop="8dp" android:layout_marginHorizontal="3dp"
    android:max="1000" android:progress="0" android:visibility="gone"
    android:progressTint="#69D8E9" android:progressBackgroundTint="#44536D89"/>
</LinearLayout>