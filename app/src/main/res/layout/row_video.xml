<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="106dp"
    android:gravity="center_vertical" android:background="@drawable/video_row_bg"
    android:paddingStart="9dp" android:paddingEnd="10dp" android:layout_marginBottom="9dp">
    <FrameLayout android:layout_width="128dp" android:layout_height="84dp"
        android:background="@drawable/thumb_bg" android:clipToOutline="true">
        <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:contentDescription="Video thumbnail" />
        <TextView android:id="@+id/playGlyph" android:layout_width="37dp" android:layout_height="37dp"
            android:layout_gravity="center" android:gravity="center"
            android:background="@drawable/play_badge_bg" android:text="▶"
            android:textColor="#FFFFFF" android:textSize="15sp" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_main" android:textSize="14sp"
            android:fontFamily="sans-serif-medium" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:textColor="@color/text_secondary"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end" />
        <View android:layout_width="62dp" android:layout_height="3dp" android:layout_marginTop="9dp"
            android:background="@drawable/gradient_divider" />
    </LinearLayout>
    <TextView android:layout_width="20dp" android:layout_height="wrap_content"
        android:text="›" android:gravity="center" android:textSize="25sp" android:textColor="@color/accent" />
</LinearLayout>
