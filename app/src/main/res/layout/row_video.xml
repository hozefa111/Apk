<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="horizontal"
    android:layout_width="match_parent" android:layout_height="104dp" android:paddingVertical="5dp"
    android:gravity="center_vertical">
    <FrameLayout android:layout_width="128dp" android:layout_height="80dp" android:background="@drawable/thumb_bg">
        <ImageView android:id="@+id/thumb" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="centerCrop" android:contentDescription="Video thumbnail" />
        <TextView android:id="@+id/playGlyph" android:layout_gravity="center" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="▶" android:textColor="@color/accent" android:textSize="28sp" />
    </FrameLayout>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:orientation="vertical">
        <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_main" android:textSize="15sp" android:fontFamily="sans-serif-medium"
            android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/details" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:textColor="@color/text_secondary" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:layout_width="24dp" android:layout_height="wrap_content" android:text="›" android:textSize="26sp" android:textColor="@color/accent" />
</LinearLayout>
